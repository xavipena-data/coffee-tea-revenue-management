	measure 'Avg List Price' = ```
			DIVIDE([Gross Sales], [Units Sold])	
			```
		formatString: #,0.00
		displayFolder: 4 Average Prices
		lineageTag: e91675c5-62d6-4879-8520-678b5ff2515d

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Avg Net Price' = DIVIDE([Net Sales], [Units Sold])
		formatString: #,0.00
		displayFolder: 4 Average prices
		lineageTag: 23e50fa2-b6c0-4252-b469-32aff7bbe23b

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Avg Unit Cost' = DIVIDE([Cost of Sales], [Units Sold])
		formatString: #,0.00
		lineageTag: 81a7bd45-b5f1-46b6-9fd9-df24d0032fa3

		changedProperty = Name

		changedProperty = FormatString

	measure 'Waterfall Value' =
			
			SWITCH(
			    SELECTEDVALUE(dim_waterfall_step[step_order]),
			    1, [Gross Sales],
			    2, -[Promo Discount],
			    3, -[On Invoice Discount],
			    4, -[Rappel Amount],
			    5, -[Early Payment Discount],
			    6, -[Marketing Contribution]
			)
		formatString: #,0.00
		displayFolder: 5 Report helpers
		lineageTag: 6f1a4655-0297-48d4-87fc-1465a3265434

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

