	measure 'Promo Waterfall Value' =
			
			SWITCH (
			    SELECTEDVALUE ( dim_promo_step[step_order] ),
			    1,   CALCULATE ( SUM ( fact_promo_performance[margin_on_extra_units] ),  fact_promo_performance[has_baseline] = TRUE () ),
			    2, - CALCULATE ( SUM ( fact_promo_performance[discount_on_base_units] ), fact_promo_performance[has_baseline] = TRUE () ),
			    3, - CALCULATE ( SUM ( fact_promo_performance[promo_support_cost] ),     fact_promo_performance[has_baseline] = TRUE () ),
			    4, - CALCULATE ( SUM ( fact_promo_performance[dip_margin_loss] ),        fact_promo_performance[has_baseline] = TRUE () )
			)
		formatString: #,0.00
