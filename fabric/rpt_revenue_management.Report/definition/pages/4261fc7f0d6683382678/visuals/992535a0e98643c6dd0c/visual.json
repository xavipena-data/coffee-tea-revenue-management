                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Each bubble is a customer; its size is net sales. The further to the right, the more commercial terms the customer gets (on-invoice, rappel, early payment and marketing), and the lower its margin tends to be."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The pattern is clear: margin falls as terms rise. Large Retail customers (black) combine the highest terms with the lowest margin, so they sell a lot but earn little. Online sits in the opposite corner, with almost no terms and the highest margin."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Terms here exclude promotional discounts, which are analysed on the Promotions page."
                  }
                ]
              }
            ]
