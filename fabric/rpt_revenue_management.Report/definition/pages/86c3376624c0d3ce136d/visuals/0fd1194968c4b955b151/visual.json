    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read this bridge",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#0d0d0d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Compares the gross margin (net sales minus cost of sales) of the selected year with the previous year, at product x channel level.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#0d0d0d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Volume: change in total units, valued at last year's average margin per unit.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#0d0d0d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Mix: shift in weight between products and channels.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#0d0d0d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "List price: change in list price per unit.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#0d0d0d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Discounts & terms: change in promotions and commercial terms per unit.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#0d0d0d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Raw material cost: change in raw material cost per unit, excluding FX.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#0d0d0d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "FX: effect of the USD/EUR rate on raw material cost, using the annual average rate.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#0d0d0d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Other cost: change in the rest of the unit cost.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#0d0d0d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Notes: products and channels sold in only one of the two years go entirely into Mix. Distributed brands pass costs through with a lag, so the FX split is an approximation for them. Simulated data.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#0d0d0d"
                    }
                  }
                ]
              }
            ]
          }
        }
