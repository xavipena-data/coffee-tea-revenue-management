                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The curves apply a price change from -10% to +10% to every product. Volume reacts with a constant elasticity per product and channel, taken from the parameters of the simulated scenario; unit cost and commercial terms (as a % of gross sales) stay unchanged."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Retail is the most sensitive channel: the same price move changes its margin far more than in any other channel, because its starting margin is thin. Online barely moves. In euros, the effect is much more even, so use the scenario selector and the cards to see it."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Within this range there is no interior optimum: margin rises with price in every channel, at the cost of volume. The model has no competitor reaction and no cross effects between products."
                  }
                ]
              }
            ]
          }
        }
      ]
